# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch / build artifacts (not part of source)
/.data/
*.log
*.result.json
_*.cjs
_*.mjs
# ⚠️ 上面这条会忽略 tools/ 下任何 _ 开头的模块。仓库内共用模块不要用前导下划线命名：
# 2026-11-10 踩过一次 —— tools/_chrome.mjs 被静默漏提交，`git add tools/` 不报错，
# 8 个工具的 import 全部悬空，直到 `git show --stat` 才发现少一个文件。
serve.mjs
serve*.log
build*.log
gen_log.txt
gen_summary.txt
gens_*.txt
verify-*.json
verify-*.ts
review-*.json
compare-*.json
server.*
*length*)
